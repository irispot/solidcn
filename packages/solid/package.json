{
  "name": "@solid-cn/ui",
  "version": "0.0.0-rc.0",
  "description": "Shadcn components for Solid 2, built on native Solid Base UI",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "LUCIDE-LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "browser": "./dist/index.js",
      "node": "./dist/server/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/*": "./dist/styles/*",
    "./utils": {
      "types": "./dist/utils.d.ts",
      "solid": "./src/utils.ts",
      "browser": "./dist/utils.js",
      "node": "./dist/server/utils.js",
      "default": "./dist/utils.js"
    },
    "./use-mobile": {
      "types": "./dist/use-mobile.d.ts",
      "solid": "./src/use-mobile.ts",
      "browser": "./dist/use-mobile.js",
      "node": "./dist/server/use-mobile.js",
      "default": "./dist/use-mobile.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "solid": "./src/*.tsx",
      "browser": "./dist/*.js",
      "node": "./dist/server/*.js",
      "default": "./dist/*.js"
    }
  },
  "peerDependencies": {
    "solid-js": "2.0.0-rc.8",
    "@solidjs/web": "2.0.0-rc.8"
  },
  "dependencies": {
    "@solid-cn/base-ui": "0.0.0-rc.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns-jalali": "4.1.0-0",
    "embla-carousel": "^8.6.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  }
}
