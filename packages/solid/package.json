{
  "name": "@solid-cn/base-ui",
  "version": "0.0.0-rc.0",
  "description": "Base UI components for Solid 2",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "CONTROLS.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "browser": "./dist/index.js",
      "node": "./dist/server/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "solid": "./src/*/index.ts",
      "browser": "./dist/*/index.js",
      "node": "./dist/server/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "peerDependencies": {
    "solid-js": "2.0.0-rc.8",
    "@solidjs/web": "2.0.0-rc.8"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6"
  }
}
